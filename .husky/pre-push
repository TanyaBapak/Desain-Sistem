#!/usr/bin/env sh
set -e

remote_name=$1
zero_sha=0000000000000000000000000000000000000000
failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  [ "$local_ref" = "(delete)" ] && continue

  if [ "$remote_sha" != "$zero_sha" ]; then
    base_sha=$remote_sha
  else
    base_branch=
    for branch in main master; do
      candidate="refs/remotes/$remote_name/$branch"
      if git show-ref --verify --quiet "$candidate"; then
        base_branch=$candidate
        break
      fi
    done

    if [ -z "$base_branch" ]; then
      echo "Push ditolak: tidak dapat menemukan remote main/master untuk memeriksa artefak build."
      echo "Fetch remote dan pastikan branch utama tersedia sebagai remote-tracking branch."
      exit 1
    fi
    base_sha=$(git merge-base "$local_sha" "$base_branch") || {
      echo "Push ditolak: tidak dapat menentukan basis commit untuk pemeriksaan artefak."
      exit 1
    }
  fi

  for commit in $(git rev-list "$local_sha" "^$base_sha"); do
    if git diff-tree --no-commit-id --name-only -r -m "$commit" \
      | grep -E '^(backend/)?public/build/' >/dev/null; then
      echo "Push ditolak: commit $commit mencakup artefak hasil build di public/build/."
      failed=1
    fi
  done
done

if [ "$failed" -ne 0 ]; then
  echo "Hapus perubahan artefak build dari commit; gunakan file sumber dan pnpm build untuk pemeriksaan lokal."
  exit 1
fi

echo "Tidak ada artefak build pada commit yang akan di-push."
